{
  "name": "conversation-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-agnostic engine for conversation scenarios",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:packages",
    "build:packages": "pnpm --filter './packages/**' -r build",
    "check": "pnpm format:check && pnpm build:packages && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "prepare": "husky",
    "release": "changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter './packages/**' -r typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,json,jsonc,md,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs,ts}": "eslint --fix"
  }
}
